    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: Debug Proxy",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/proxy",
            "args": ["5000", "120"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Make"
        },
        {
            "name": "C/C++: Debug Client",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/client",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Make"
        },
        {
            "name": "C/C++: Debug Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Make test"
        }
    ]
}